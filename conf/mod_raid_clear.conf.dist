[worldserver]

########################################
# mod-raid-clear
#
# Boss and trash mechanics for playerbots raids, raid by raid. Works on top of mod-playerbots'
# own raid strategies (it only adds what they're missing) and alongside mod-dungeon-clear, which
# walks the raid from boss to boss and hands each boss fight to the bots' strategies.
#
# Needs mod-playerbots.
########################################

#
#    RaidClear.Enable
#        Description: Master switch. Read at startup; turning it on later needs a restart.
#        Default:     1
#

RaidClear.Enable = 1

#
#    RaidClear.KillOrder
#        Description: The group's main tank bot (or first tank bot) keeps the skull raid icon on
#                     the add that should die first: Lava Spawn, then healers, then other boss
#                     adds. DPS bots always attack skull first. It never moves a skull that is
#                     already on an add of the same or higher priority.
#        Default:     1
#

RaidClear.KillOrder = 1

#
#    RaidClear.Tanks.AssignMainTank
#        Description: In every raid, if the group has two or more tanks and nobody has the Main
#                     Tank flag, give it to the tank playerbots already treats as main (the first
#                     tank in group order; `.botraid sort` puts tanks first). With the flag set
#                     the main tank sticks to its own target, and mod-dungeon-clear picks the same
#                     tank as its leader. A Main Tank you set yourself is never changed.
#        Default:     1
#

RaidClear.Tanks.AssignMainTank = 1

#
#    RaidClear.Tanks.Split
#        Description: In every raid, the other tanks act as off-tanks: they never take the main
#                     tank's target, they pick up mobs hitting non-tanks first, then extra mobs on
#                     the main tank, and leave mobs another off-tank holds.
#        Default:     1
#

RaidClear.Tanks.Split = 1

#
#    RaidClear.Tanks.Separation
#        Description: Minimum distance (yards) between the off-tank's mob and the main tank's mob
#                     on trash. Mobs with a big AoE get more: each raid lists their radius and the
#                     pair is kept at least the sum apart (Molten Core: Molten Giants 30 yd apart,
#                     Molten Destroyers 36). Only spots on dry ground at about the same height and
#                     in the main tank's line of sight are used. 0 = don't move.
#        Default:     12
#

RaidClear.Tanks.Separation = 12

#
#    RaidClear.Tanks.SeparateOnBosses
#        Description: Also separate while a boss is in the fight. Off by default: boss rooms have
#                     their own positioning (and some boss strategies place the tanks themselves).
#                     Off-tanks still take the boss's adds either way.
#        Default:     0
#

RaidClear.Tanks.SeparateOnBosses = 0

#
#    RaidClear.MoltenCore.Enable
#        Description: Molten Core strategy (map 409): kill order, Tremor Totem on Magmadar,
#                     no attacks into Majordomo's reflection shields, ranged out of Ragnaros'
#                     knockback.
#        Default:     1
#

RaidClear.MoltenCore.Enable = 1
